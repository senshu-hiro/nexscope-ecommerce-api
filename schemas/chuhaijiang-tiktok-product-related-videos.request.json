{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string",
      "description": "Lowercase TikTok market code.",
      "enum": [
        "br",
        "de",
        "es",
        "fr",
        "gb",
        "id",
        "it",
        "jp",
        "mx",
        "my",
        "ph",
        "sg",
        "th",
        "us",
        "vn"
      ],
      "example": "us"
    },
    "page": {
      "type": "integer",
      "description": "Page number, starting at 1.",
      "minimum": 1,
      "example": 1
    },
    "pageSize": {
      "type": "integer",
      "description": "Maximum records per page.",
      "minimum": 1,
      "maximum": 10,
      "example": 5
    },
    "id": {
      "type": "string",
      "description": "Product ID, preserved as a string.",
      "minLength": 1,
      "example": "1732052189676081387"
    }
  },
  "required": [
    "country",
    "id"
  ]
}
