{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string",
      "description": "Lowercase TikTok market code.",
      "enum": [
        "br",
        "de",
        "es",
        "fr",
        "gb",
        "id",
        "it",
        "jp",
        "mx",
        "my",
        "ph",
        "sg",
        "th",
        "us",
        "vn"
      ],
      "example": "us"
    },
    "page": {
      "type": "integer",
      "description": "Page number, starting at 1.",
      "minimum": 1,
      "example": 1
    },
    "pageSize": {
      "type": "integer",
      "description": "Maximum records per page.",
      "minimum": 1,
      "maximum": 10,
      "example": 5
    },
    "keyword": {
      "type": "string",
      "description": "Product search keyword.",
      "example": "beauty"
    },
    "category": {
      "type": "string",
      "description": "Product category ID."
    },
    "sellerType": {
      "type": "string",
      "description": "Seller type: 1 overseas non-brand, 2 local, 3 brand, 4 non-brand.",
      "enum": [
        "1",
        "2",
        "3",
        "4"
      ],
      "example": "2"
    },
    "freeShipping": {
      "type": "boolean",
      "description": "Filter by free shipping availability.",
      "example": true
    },
    "sort": {
      "type": "string",
      "description": "Provider sort field and direction (field:asc or field:desc).",
      "default": "gmv_7d:desc",
      "pattern": "^(daily_sold|gmv_30d|gmv_7d|price|rating|sold_30d|sold_7d):(asc|desc)$",
      "example": "gmv_7d:desc"
    },
    "minPrice": {
      "type": "number",
      "description": "Minimum price in USD."
    },
    "maxPrice": {
      "type": "number",
      "description": "Maximum price in USD."
    },
    "minRating": {
      "type": "number",
      "description": "Minimum product rating.",
      "minimum": 0,
      "maximum": 5
    },
    "maxRating": {
      "type": "number",
      "description": "Maximum product rating.",
      "minimum": 0,
      "maximum": 5
    },
    "minSold7d": {
      "type": "number",
      "description": "Minimum 7-day sales."
    },
    "maxSold7d": {
      "type": "number",
      "description": "Maximum 7-day sales."
    },
    "minSold30d": {
      "type": "number",
      "description": "Minimum 30-day sales."
    },
    "maxSold30d": {
      "type": "number",
      "description": "Maximum 30-day sales."
    }
  },
  "required": [
    "country"
  ]
}
