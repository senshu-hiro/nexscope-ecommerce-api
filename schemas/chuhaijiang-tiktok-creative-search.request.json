{
  "required": [
    "country"
  ],
  "type": "object",
  "properties": {
    "country": {
      "enum": [
        "br",
        "de",
        "es",
        "fr",
        "gb",
        "id",
        "it",
        "jp",
        "mx",
        "my",
        "ph",
        "sg",
        "th",
        "us",
        "vn"
      ],
      "type": "string",
      "description": "Lowercase request market. Returned country_code may differ; preserve both."
    },
    "page": {
      "default": 1,
      "minimum": 1,
      "type": "integer",
      "description": "Page number, starting at 1. No automatic pagination."
    },
    "pageSize": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer",
      "description": "Items per page, from 1 to 10. Omission preserves the upstream default."
    },
    "keyword": {
      "type": "string",
      "description": "Creative search keyword."
    },
    "category": {
      "type": "string",
      "description": "Provider-approved creative category."
    },
    "hasProduct": {
      "type": "boolean",
      "description": "Whether products are associated."
    },
    "isSponsored": {
      "type": "boolean",
      "description": "Whether content is sponsored."
    },
    "isAigc": {
      "type": "boolean",
      "description": "Whether content is generated by AI."
    },
    "sort": {
      "pattern": "^[^:]+:(asc|desc)$",
      "default": "gmv:desc",
      "type": "string",
      "description": "Provider-approved field followed by :asc or :desc. No complete field enum is published."
    }
  },
  "additionalProperties": false
}
