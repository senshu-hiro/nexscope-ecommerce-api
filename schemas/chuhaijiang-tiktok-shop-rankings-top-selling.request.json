{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string",
      "description": "Lowercase TikTok market code.",
      "enum": [
        "br",
        "de",
        "es",
        "fr",
        "gb",
        "id",
        "it",
        "jp",
        "mx",
        "my",
        "ph",
        "sg",
        "th",
        "us",
        "vn"
      ],
      "example": "us"
    },
    "page": {
      "type": "integer",
      "description": "Page number, starting at 1.",
      "minimum": 1,
      "example": 1
    },
    "pageSize": {
      "type": "integer",
      "description": "Maximum records per page.",
      "minimum": 1,
      "maximum": 20,
      "example": 5
    },
    "date": {
      "type": "string",
      "description": "Ranking date in YYYYMMDD format.",
      "pattern": "^[0-9]{8}$",
      "example": "20260824"
    },
    "granularity": {
      "type": "string",
      "description": "Ranking period.",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "0",
        "1",
        "2"
      ],
      "example": "daily"
    },
    "category": {
      "type": "string",
      "description": "Product category ID."
    },
    "shopType": {
      "type": "string",
      "description": "Provider shop type.",
      "enum": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    "sort": {
      "type": "string",
      "description": "Provider sort field and direction (field:asc or field:desc).",
      "default": "interval_sold_count:desc",
      "pattern": "^[A-Za-z0-9_]+:(asc|desc)$",
      "example": "interval_sold_count:desc"
    }
  },
  "required": [
    "country",
    "date",
    "granularity"
  ]
}
