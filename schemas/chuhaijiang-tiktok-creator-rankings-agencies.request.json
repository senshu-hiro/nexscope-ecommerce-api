{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string",
      "description": "Lowercase TikTok market code.",
      "enum": [
        "br",
        "de",
        "es",
        "fr",
        "gb",
        "id",
        "it",
        "jp",
        "mx",
        "my",
        "ph",
        "sg",
        "th",
        "us",
        "vn"
      ],
      "example": "us"
    },
    "page": {
      "type": "integer",
      "description": "Page number, starting at 1.",
      "minimum": 1,
      "example": 1
    },
    "pageSize": {
      "type": "integer",
      "description": "Maximum records per page.",
      "minimum": 1,
      "maximum": 20,
      "example": 5
    },
    "sort": {
      "type": "string",
      "description": "Provider sort field and direction (field:asc or field:desc).",
      "default": "gmv_30d:desc",
      "pattern": "^[A-Za-z0-9_]+:(asc|desc)$",
      "example": "gmv_30d:desc"
    },
    "category": {
      "type": "string",
      "description": "Agency category."
    }
  },
  "required": [
    "country"
  ]
}
